ype=\"device_forever\"></block>\n</xml>","main.ts":"\n","README.md":"","pxt.json":"{\n    \"name\": \"gamepad  conrad\",\n    \"description\": \"\",\n    \"dependencies\": {\n        \"core\": \"*\",\n        \"radio\": \"*\",\n        \"microphone\": \"*\"\n    },\n    \"files\": [\n        \"main.blocks\",\n        \"main.ts\",\n        \"README.md\"\n    ],\n    \"additionalFilePaths\": []\n}\n"}},{"timestamp":1794953331492,"editorVersion":"9.0.12","text":{"main.blocks":"<xml xmlns=\"https://developers.google.com/blockly/xml\"><variables></variables><block type=\"pxt-on-start\" x=\"20\" y=\"20\"></block><block type=\"device_forever\" x=\"257\" y=\"20\"></block></xml>","main.ts":"// =====================================\n// TRU COMPONENTS GAMEPAD\n// TEST JOYSTICKA ANALOGOWEGO X / Y\n// micro:bit V2\n// =====================================\n\n// Wylaczenie matrycy LED\nled.enable(false)\n\n// Informacja o rozpoczeciu testu\nserial.writeLine(\"================================\")\nserial.writeLine(\"TEST JOYSTICKA ANALOGOWEGO\")\nserial.writeLine(\"ODCZYT PINOW P3 I P4\")\nserial.writeLine(\"================================\")\n\nbasic.forever(function () {\n\n    // Odczyt analogowy\n    let p3 = pins.analogReadPin(AnalogPin.P3)\n    let p4 = pins.analogReadPin(AnalogPin.P4)\n\n    // Wyswietlenie wynikow przez USB\n    serial.writeLine(\"P3=\" + p3 + \"  P4=\" + p4)\n\n    // Odczyt co 200 ms\n    basic.pause(200)\n})","README.md":"","truGamepad.ts":"/**\n * TRU COMPONENTS Gamepad\n * Biblioteka dla BBC micro:bit V2\n *\n * UWAGA:\n * Gamepad wykorzystuje piny wspoldzielone\n * z matryca LED micro:bita.\n * Funkcja init() wylacza matryce LED.\n */\n\n//% color=\"#008080\" icon=\"\\uf11b\" block=\"TRU Gamepad\"\nnamespace truGamepad {\n\n    export enum Button {\n        //% block=\"UP\"\n        UP = 10,\n\n        //% block=\"DOWN\"\n        DOWN = 8,\n\n        //% block=\"LEFT\"\n        LEFT = 11,\n\n        //% block=\"RIGHT\"\n        RIGHT = 9\n    }\n\n    /**\n     * Inicjalizacja gamepada.\n     * Wylacza matryce LED micro:bita.\n     */\n    //% block=\"inicjalizuj gamepad\"\n    //% weight=100\n    export function init(): void {\n        led.enable(false)\n\n        pins.setPull(DigitalPin.P10, PinPullMode.PullUp)\n        pins.setPull(DigitalPin.P8, PinPullMode.PullUp)\n        pins.setPull(DigitalPin.P11, PinPullMode.PullUp)\n        pins.setPull(DigitalPin.P9, PinPullMode.PullUp)\n    }\n\n    /**\n     * Sprawdza, czy przycisk jest nacisniety.\n     */\n    //% block=\"czy przycisk %button jest nacisniety\"\n    //% weight=90\n    export function isPressed(button: Button): boolean {\n        return pins.digitalReadPin(button as number) == 0\n    }\n\n    /**\n     * Wykonuje kod po nacisnieciu przycisku.\n     */\n    //% block=\"po nacisnieciu przycisku %button\"\n    //% weight=80\n    export function onButtonPressed(\n        button: Button,\n        handler: () => void\n    ): void {\n\n        let wasPressed = false\n\n        control.inBackground(function () {\n            while (true) {\n                let pressed = isPressed(button)\n\n                if (pressed && !wasPressed) {\n                    handler()\n                }\n\n                wasPressed = pressed\n                basic.pause(20)\n            }\n        })\n    }\n}","pxt.json":"{\n    \"name\": \"pxt-tru-gamepad\",\n    \"description\": \"\",\n    \"dependencies\": {\n        \"core\": \"*\",\n        \"radio\": \"*\",\n        \"microphone\": \"*\"\n    },\n    \"files\": [\n        \"main.blocks\",\n        \"main.ts\",\n        \"README.md\",\n        \"truGamepad.ts\"\n    ],\n    \"preferredEditor\": \"tsprj\"\n}\n"}}],"shares":[],"lastSaveTime":1794954518011}