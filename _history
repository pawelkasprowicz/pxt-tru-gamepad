{"entries":[{"timestamp":1794951367232,"editorVersion":"9.0.12","changes":[{"type":"edited","filename":"main.blocks","patch":[{"start1":0,"length1":185,"diffs":[[1,"<xml xmlns=\"http://www.w3.org/1999/xhtml\">\n  <block type=\"pxt-on-start\"></block>\n  <block type=\"device_forever\"></block>\n</xml>"]]}]},{"type":"edited","filename":"main.ts","patch":[{"start1":0,"length1":61,"diffs":[[1,""]]},{"start1":1,"length1":448,"diffs":[[1,""]]}]},{"type":"edited","filename":"pxt.json","patch":[{"start1":2,"length1":31,"diffs":[[1,"    \"name\": \"gamepad  conrad\",\n"]]},{"start1":211,"length1":45,"diffs":[[1,"        \"README.md\"\n"]]},{"start1":238,"length1":31,"diffs":[[1,"    \"additionalFilePaths\": []\n"]]}]},{"type":"added","filename":"truGamepad.ts","value":"/**\n * TRU COMPONENTS Gamepad\n * Biblioteka dla BBC micro:bit V2\n *\n * UWAGA:\n * Gamepad wykorzystuje piny wspoldzielone\n * z matryca LED micro:bita.\n * Funkcja init() wylacza matryce LED.\n */\n\n//% color=\"#008080\" icon=\"\\uf11b\" block=\"TRU Gamepad\"\nnamespace truGamepad {\n\n    export enum Button {\n        //% block=\"UP\"\n        UP = 10,\n\n        //% block=\"DOWN\"\n        DOWN = 8,\n\n        //% block=\"LEFT\"\n        LEFT = 11,\n\n        //% block=\"RIGHT\"\n        RIGHT = 9\n    }\n\n    /**\n     * Inicjalizacja gamepada.\n     * Wylacza matryce LED micro:bita.\n     */\n    //% block=\"inicjalizuj gamepad\"\n    //% weight=100\n    export function init(): void {\n        led.enable(false)\n\n        pins.setPull(DigitalPin.P10, PinPullMode.PullUp)\n        pins.setPull(DigitalPin.P8, PinPullMode.PullUp)\n        pins.setPull(DigitalPin.P11, PinPullMode.PullUp)\n        pins.setPull(DigitalPin.P9, PinPullMode.PullUp)\n    }\n\n    /**\n     * Sprawdza, czy przycisk jest nacisniety.\n     */\n    //% block=\"czy przycisk %button jest nacisniety\"\n    //% weight=90\n    export function isPressed(button: Button): boolean {\n        return pins.digitalReadPin(button as number) == 0\n    }\n\n    /**\n     * Wykonuje kod po nacisnieciu przycisku.\n     */\n    //% block=\"po nacisnieciu przycisku %button\"\n    //% weight=80\n    export function onButtonPressed(\n        button: Button,\n        handler: () => void\n    ): void {\n\n        let wasPressed = false\n\n        control.inBackground(function () {\n            while (true) {\n                let pressed = isPressed(button)\n\n                if (pressed && !wasPressed) {\n                    handler()\n                }\n\n                wasPressed = pressed\n                basic.pause(20)\n            }\n        })\n    }\n}"}]},{"timestamp":1794951955405,"editorVersion":"9.0.12","changes":[{"type":"edited","filename":"main.ts","patch":[{"start1":26,"length1":23,"diffs":[[1,"// TEST BIBLIOTEKI\n"]]},{"start1":62,"length1":18,"diffs":[[1,"truGamepad.init()\n"]]},{"start1":81,"length1":348,"diffs":[[1,"serial.writeLine(\"TRU GAMEPAD - START\")\n"]]},{"start1":122,"length1":132,"diffs":[[1,"truGamepad.onButtonPressed(truGamepad.Button.UP, function () {\n    serial.writeLine(\"UP\")\n})\n"]]},{"start1":216,"length1":38,"diffs":[[1,"truGamepad.onButtonPressed(truGamepad.Button.DOWN, function () {\n    serial.writeLine(\"DOWN\")\n})\n"]]},{"start1":314,"length1":28,"diffs":[[1,"truGamepad.onButtonPressed(truGamepad.Button.LEFT, function () {\n    serial.writeLine(\"LEFT\")\n})\n"]]},{"start1":412,"length1":273,"diffs":[[1,"truGamepad.onButtonPressed(truGamepad.Button.RIGHT, function () {\n    serial.writeLine(\"RIGHT\")\n"]]}]}]},{"timestamp":1794952268969,"editorVersion":"9.0.12","changes":[{"type":"edited","filename":"main.ts","patch":[{"start1":0,"length1":41,"diffs":[[1,""]]},{"start1":26,"length1":36,"diffs":[[1,"// IDENTYFIKACJA PINOW\n"]]},{"start1":65,"length1":41,"diffs":[[1,""]]},{"start1":66,"length1":26,"diffs":[[1,""]]},{"start1":85,"length1":228,"diffs":[[1,"let testPins = [\n    DigitalPin.P0,\n    DigitalPin.P1,\n    DigitalPin.P2,\n    DigitalPin.P3,\n    DigitalPin.P4